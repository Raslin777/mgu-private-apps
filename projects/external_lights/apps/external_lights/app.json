{
  "id": "external_lights",
  "title": "External Lights",
  "description": "Light shows on the car's exterior lamps, and each lamp on its own for a test. Only while the car stands. Not car-tested.",
  "version": "0.1.0",
  "vendor": "custom",
  "loggingId": "EXLT",
  "iconGlyph": "EL",
  "screens": [
    { "name": "MAIN", "kind": "canvas", "title": "External Lights",
      "buttons": [["BTN_START", "Start"], ["BTN_STOP", "Stop"], ["BTN_SHOW", "Next show"], ["BTN_LAMP", "Next lamp"], ["BTN_FLASH", "Flash lamp"]] }
  ],
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    }
  },
  "settings": [
    { "key": "glare", "label": "High beam and rear fog light too", "type": "bool", "default": false },
    { "key": "minutes", "label": "A show ends after (minutes)", "type": "choice", "default": "3",
      "options": [["1", "1"], ["3", "3"], ["10", "10"]] }
  ]
}
