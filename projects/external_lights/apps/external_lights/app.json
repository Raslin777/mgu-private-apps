{
  "id": "external_lights",
  "title": "External Lights",
  "description": "Exterior lamp effects with diagnostic session checks. Movement warning only. Not car-tested.",
  "version": "0.2.4",
  "vendor": "custom",
  "loggingId": "EXLT",
  "iconGlyph": "EL",
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "External Lights",
      "buttons": [
        [
          "BTN_START",
          "Start"
        ],
        [
          "BTN_STOP",
          "Stop"
        ],
        [
          "BTN_SHOW",
          "Next show"
        ],
        [
          "BTN_LAMP",
          "Next lamp"
        ],
        [
          "BTN_FLASH",
          "Flash lamp"
        ],
        [
          "BTN_TESTS",
          "Address tests"
        ]
      ]
    },
    {
      "name": "DIAGNOSTICS",
      "kind": "canvas",
      "title": "Diagnostic address tests",
      "buttons": [
        [
          "BTN_TEST_SOURCE",
          "Next address"
        ],
        [
          "BTN_TEST_READ",
          "Read test"
        ],
        [
          "BTN_TEST_WRITE",
          "Write test"
        ],
        [
          "BTN_TEST_STOP",
          "Stop test"
        ],
        [
          "BTN_TEST_EARLIER",
          "Earlier"
        ],
        [
          "BTN_TEST_LATER",
          "Later"
        ],
        [
          "BTN_TEST_BACK",
          "Back"
        ]
      ]
    }
  ],
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s"
    }
  },
  "settings": [
    {
      "key": "glare",
      "label": "Rear fog light too",
      "type": "bool",
      "default": false
    },
    {
      "key": "minutes",
      "label": "A show ends after (minutes)",
      "type": "choice",
      "default": "3",
      "options": [
        [
          "1",
          "1"
        ],
        [
          "3",
          "3"
        ],
        [
          "10",
          "10"
        ]
      ]
    },
    {
      "key": "testSource",
      "label": "Diagnostic test source (lighting stays F2)",
      "type": "choice",
      "default": "F4",
      "options": [
        [
          "F2",
          "F2 (baseline)"
        ],
        [
          "F1",
          "F1"
        ],
        [
          "F4",
          "F4"
        ],
        [
          "F5",
          "F5"
        ]
      ]
    }
  ]
}
