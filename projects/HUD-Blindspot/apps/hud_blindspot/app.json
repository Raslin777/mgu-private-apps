 "signals": {
  "de.bmw.dass.driverassistanceapplications.LateralCollisionAvoidance": {
   "_instances": "1",
   "_optional": "Primary SOME/IP warning source",
   "lateralCollisionAvoidanceQualifiers": "s",
   "_broadcasts": [
    "requestWarningSteeringWheelExteriorMirror"
   ]
  },
  "de.bmw.dass.driverassistanceapplications.AssistedDrivingViewLateralCollisionAvoidance": {
   "_instances": "1",
   "_optional": "Secondary read-only lane-change warning notifications",
   "_broadcasts": [
    "assistedDrivingViewLcaInput"
   ]
  },
  "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
   "_instances": "SystemFunctionsInternalTasuInst1",
   "_optional": "Read-only D347 mirror status read (Auto fallback and its own mode)",
   "_methods": [
    "sendTasuRequest"
   ],
   "_broadcasts": [
    "sendTasuResponse"
   ]
  },
  "de.bmw.dass.GapVehicleAhead": {
   "_instances": "1",
   "_optional": "Read-only reachability check for the connection page",
   "GapVehicleDrivingAhead": "s"
  },
  "de.bmw.dass.AssistedDrivingViewFunctionInput": {
   "_instances": "1",
   "_optional": "Read-only reachability check for the connection page",
   "_broadcasts": [
    "assistedDrivingViewFunctionInputIbVip"
   ]
  },
  "de.bmw.dass.pad.communication.AssistedDrivingViewLateralFunctionInput": {
   "_instances": "1",
   "_optional": "Read-only reachability check for the connection page",
   "_broadcasts": [
    "lateralFunctionInputAssistedDrivingView"
   ]
  },
  "de.bmw.dass.pad.communication.ObjectListSuAAR": {
   "_instances": "1",
   "_optional": "Read-only reachability check for the connection page",
   "_broadcasts": [
    "suAARObjectList"
   ]
  }
 },
