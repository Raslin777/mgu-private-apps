{
  "id": "camera-cluster-feed",
  "kind": "tool",
  "version": "0.1.0",
  "title": "Camera Cluster feed",
  "description": "Decodes the car's camera stream for the Camera Cluster app and hands the picture to Cluster renderer. Runs only after the app is opened. Not car-tested.",
