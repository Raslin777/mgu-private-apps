[Unit]
Description=Camera Cluster feed control socket

[Socket]
# The Camera Cluster app's link to the feed. Nothing runs until the app opens
# it: the first connection starts camera-cluster-feed.service.
ListenStream=/dev/shm/camera-cluster-feed/ctl.sock
DirectoryMode=0755
SocketMode=0660
# Every OAP app process has tm_oap_app as a supplementary group.
SocketGroup=tm_oap_app

[Install]
WantedBy=sockets.target
