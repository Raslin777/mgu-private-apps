[Unit]
Description=AI Terminal root helper socket

[Socket]
ListenStream=/run/mgu-ai-root/root.sock
DirectoryMode=0755
SocketMode=0660
# Every OAP app process has tm_oap_app as a supplementary group. The helper
# additionally requires the token that provision.sh gives to AI Terminal only.
SocketGroup=tm_oap_app
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
